{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-twin.local/schemas/object-identification-prediction.schema.json",
  "title": "Object Identification Prediction",
  "description": "Prototype, non-operational object-identification output contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "record_id",
    "generated_at",
    "observation_id",
    "observation_timestamp",
    "canonical_object_id",
    "identity_status",
    "affiliation",
    "classification",
    "match_score",
    "match_score_interpretation",
    "threshold",
    "catalog_provenance",
    "affiliation_provenance",
    "matching_method",
    "data_quality",
    "rationale",
    "artifact_metadata",
    "use_designation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "canonical_object_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "identity_status": {
      "enum": ["known", "unknown"]
    },
    "affiliation": {
      "enum": ["blue", "red", "other", "unknown"]
    },
    "classification": {
      "enum": ["known_blue", "known_red", "known_other", "unknown"]
    },
    "match_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "match_score_interpretation": {
      "type": "string",
      "minLength": 1
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "version", "validation_status"],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "validation_status": {
          "enum": ["prototype_unvalidated", "operationally_validated"]
        }
      }
    },
    "catalog_provenance": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/catalogProvenance"
        }
      ]
    },
    "affiliation_provenance": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/affiliationProvenance"
        }
      ]
    },
    "matching_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "method_type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "method_type": {
          "enum": ["rule", "similarity", "machine_learning", "hybrid"]
        }
      }
    },
    "candidate_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_basis",
        "candidate_count",
        "ambiguity_margin",
        "best_to_second_score_gap"
      ],
      "properties": {
        "decision_basis": {
          "enum": [
            "clear_match",
            "ambiguous",
            "no_candidate_above_threshold"
          ]
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1
        },
        "ambiguity_margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "best_to_second_score_gap": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "candidate_rankings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "canonical_object_id",
          "affiliation",
          "match_score",
          "meets_threshold",
          "position_residual_km",
          "velocity_residual_km_s",
          "catalog_provenance"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "canonical_object_id": {
            "type": "string",
            "minLength": 1
          },
          "affiliation": {
            "enum": ["blue", "red", "other"]
          },
          "match_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "meets_threshold": {
            "type": "boolean"
          },
          "position_residual_km": {
            "type": "number",
            "minimum": 0
          },
          "velocity_residual_km_s": {
            "type": "number",
            "minimum": 0
          },
          "catalog_provenance": {
            "$ref": "#/$defs/catalogProvenance"
          }
        }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": {
          "enum": ["complete", "degraded", "invalid"]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "severity", "message"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": ["warning", "error"]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "training_data_designation"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "training_data_designation": {
          "enum": [
            "not_applicable",
            "synthetic_prototype",
            "operationally_validated"
          ]
        }
      }
    },
    "use_designation": {
      "enum": ["prototype_non_operational", "operationally_approved"]
    }
  },
  "$defs": {
    "catalogProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_source",
        "catalog_record_id",
        "catalog_record_valid_at"
      ],
      "properties": {
        "catalog_source": {
          "type": "string",
          "minLength": 1
        },
        "catalog_record_id": {
          "type": "string",
          "minLength": 1
        },
        "catalog_record_valid_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "affiliationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affiliation_authority",
        "affiliation_source_record_id",
        "affiliation_effective_at",
        "affiliation_expires_at"
      ],
      "properties": {
        "affiliation_authority": {
          "type": "string",
          "minLength": 1
        },
        "affiliation_source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "affiliation_effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "affiliation_expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identity_status": {
            "const": "unknown"
          }
        },
        "required": ["identity_status"]
      },
      "then": {
        "properties": {
          "canonical_object_id": {
            "type": "null"
          },
          "affiliation": {
            "const": "unknown"
          },
          "classification": {
            "const": "unknown"
          },
          "catalog_provenance": {
            "type": "null"
          },
          "affiliation_provenance": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_status": {
            "const": "known"
          }
        },
        "required": ["identity_status"]
      },
      "then": {
        "properties": {
          "canonical_object_id": {
            "type": "string",
            "minLength": 1
          },
          "affiliation": {
            "enum": ["blue", "red", "other"]
          },
          "classification": {
            "enum": ["known_blue", "known_red", "known_other"]
          },
          "catalog_provenance": {
            "$ref": "#/$defs/catalogProvenance"
          },
          "affiliation_provenance": {
            "$ref": "#/$defs/affiliationProvenance"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "affiliation": {
            "const": "blue"
          }
        },
        "required": ["affiliation"]
      },
      "then": {
        "properties": {
          "identity_status": {
            "const": "known"
          },
          "classification": {
            "const": "known_blue"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "affiliation": {
            "const": "red"
          }
        },
        "required": ["affiliation"]
      },
      "then": {
        "properties": {
          "identity_status": {
            "const": "known"
          },
          "classification": {
            "const": "known_red"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "affiliation": {
            "const": "other"
          }
        },
        "required": ["affiliation"]
      },
      "then": {
        "properties": {
          "identity_status": {
            "const": "known"
          },
          "classification": {
            "const": "known_other"
          }
        }
      }
    }
  ]
}
