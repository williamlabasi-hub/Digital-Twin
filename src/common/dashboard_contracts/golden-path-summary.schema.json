{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-twin.local/schemas/golden-path-summary.schema.json",
  "title": "Golden Path Dashboard Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dashboard_contract_version",
    "scenario",
    "scenario_mode",
    "run_id",
    "run_directory",
    "orbital_source",
    "orbital_provider",
    "primary_spacecraft_id",
    "identified_secondary_object_id",
    "tracked_secondary_subject_id",
    "health_status",
    "object_identification_decision",
    "collision_assessment_status",
    "collision_risk_level",
    "coa_status",
    "evidence_usability",
    "candidate_coa_codes",
    "advisory_codes",
    "limitations",
    "artifacts"
  ],
  "properties": {
    "dashboard_contract_version": {"const": "1.0.0"},
    "scenario": {"const": "integrated_prototype_golden_path"},
    "scenario_mode": {
      "enum": [
        "nominal",
        "ambiguous_identity",
        "missing_covariance",
        "unavailable_health",
        "stale_evidence",
        "collision_abstained"
      ]
    },
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "run_directory": {"type": "string", "minLength": 1},
    "orbital_source": {"enum": ["fixture", "live"]},
    "orbital_provider": {"type": "string", "minLength": 1},
    "primary_spacecraft_id": {"type": "string", "minLength": 1},
    "identified_secondary_object_id": {"type": ["string", "null"], "minLength": 1},
    "tracked_secondary_subject_id": {"type": "string", "minLength": 1},
    "health_status": {"enum": ["Healthy", "Warning", "Degraded", "Critical", "Unknown"]},
    "object_identification_decision": {
      "enum": ["clear_match", "ambiguous", "no_candidate_above_threshold"]
    },
    "collision_assessment_status": {"enum": ["complete", "geometric_only", "abstained"]},
    "collision_risk_level": {"enum": ["negligible", "low", "moderate", "high", "critical", "undetermined"]},
    "coa_status": {"enum": ["advisory_ready", "limited", "insufficient_evidence"]},
    "evidence_usability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health", "object_identification", "collision_risk"],
      "properties": {
        "health": {"enum": ["usable", "degraded", "withheld"]},
        "object_identification": {"enum": ["usable", "degraded", "withheld"]},
        "collision_risk": {"enum": ["usable", "degraded", "withheld"]}
      }
    },
    "candidate_coa_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "advisory_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health_report",
        "orbital_generation",
        "object_identification",
        "collision_risk",
        "health_evidence",
        "object_identification_evidence",
        "collision_risk_evidence",
        "coa_report",
        "summary"
      ],
      "properties": {
        "health_report": {"type": "string", "minLength": 1},
        "orbital_generation": {"type": "string", "minLength": 1},
        "object_identification": {"type": "string", "minLength": 1},
        "collision_risk": {"type": "string", "minLength": 1},
        "health_evidence": {"type": "string", "minLength": 1},
        "object_identification_evidence": {"type": "string", "minLength": 1},
        "collision_risk_evidence": {"type": "string", "minLength": 1},
        "coa_report": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
