{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-twin.local/schemas/coa-report.schema.json",
  "title": "Course of Action Decision-Support Report",
  "description": "Prototype operator advisories derived from validated evidence. This report has no command or maneuver authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "report_id",
    "generated_at",
    "primary_subject_id",
    "secondary_subject_id",
    "status",
    "evidence_summary",
    "assessment",
    "decision_tree",
    "candidate_coas",
    "advisories",
    "operator_summary",
    "blocked_actions",
    "limitations",
    "decision_scope",
    "artifact_metadata",
    "use_designation"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "contract_version": {"const": "0.2.0"},
    "report_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "primary_subject_id": {"type": "string", "minLength": 1},
    "secondary_subject_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["advisory_ready", "limited", "insufficient_evidence"]
    },
    "evidence_summary": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_type",
          "evidence_id",
          "subject_id",
          "usability",
          "data_quality_status",
          "withheld_reason"
        ],
        "properties": {
          "evidence_type": {
            "enum": ["health", "object_identification", "collision_risk"]
          },
          "evidence_id": {"type": "string", "minLength": 1},
          "subject_id": {"type": "string", "minLength": 1},
          "usability": {"enum": ["usable", "degraded", "withheld"]},
          "data_quality_status": {
            "enum": ["complete", "degraded", "invalid"]
          },
          "withheld_reason": {"type": ["string", "null"]}
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collision_risk_level",
        "collision_probability",
        "primary_health_status",
        "secondary_identity_status",
        "secondary_affiliation"
      ],
      "properties": {
        "collision_risk_level": {
          "enum": [
            "undetermined",
            "negligible",
            "low",
            "moderate",
            "high",
            "critical"
          ]
        },
        "collision_probability": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "primary_health_status": {
          "enum": ["Unknown", "Healthy", "Warning", "Degraded", "Critical"]
        },
        "secondary_identity_status": {"enum": ["known", "unknown"]},
        "secondary_affiliation": {
          "enum": ["blue", "red", "other", "unknown"]
        }
      }
    },
    "decision_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_name", "policy_version", "terminal_node", "trace"],
      "properties": {
        "policy_name": {"const": "prototype-coa-decision-tree"},
        "policy_version": {"const": "prototype-0.2"},
        "terminal_node": {
          "enum": ["insufficient_evidence", "candidate_coas_generated"]
        },
        "trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "question", "observed_value", "branch"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1},
              "question": {"type": "string", "minLength": 1},
              "observed_value": {"type": "string", "minLength": 1},
              "branch": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "candidate_coas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "priority",
          "disposition",
          "rationale",
          "actions",
          "constraints",
          "requires_operator_approval"
        ],
        "properties": {
          "code": {"type": "string", "pattern": "^COA_[A-Z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "priority": {"enum": ["routine", "watch", "priority", "urgent"]},
          "disposition": {
            "enum": ["prerequisite", "planning_only", "recommended_for_review"]
          },
          "rationale": {"type": "string", "minLength": 1},
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "constraints": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "requires_operator_approval": {"const": true}
        }
      }
    },
    "advisories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "priority",
          "text",
          "rationale",
          "requires_operator_review"
        ],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "priority": {"enum": ["routine", "watch", "priority", "urgent"]},
          "text": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "requires_operator_review": {"type": "boolean"}
        }
      }
    },
    "operator_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "selection_basis", "selected_coa_codes", "operator_action"],
      "properties": {
        "headline": {"type": "string", "minLength": 1},
        "selection_basis": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "selected_coa_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^COA_[A-Z0-9_]+$"}},
        "operator_action": {"type": "string", "minLength": 1}
      }
    },
    "blocked_actions": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "autonomous_maneuver",
          "autonomous_spacecraft_command",
          "threat_designation_from_proximity"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_scope": {
      "const": "operator_advisory_only_no_command_authority"
    },
    "artifact_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "validation_status"],
      "properties": {
        "name": {"const": "prototype-coa-decision-support"},
        "version": {"const": "prototype-0.2"},
        "validation_status": {"const": "prototype_unvalidated"}
      }
    },
    "use_designation": {"const": "prototype_non_operational"}
  }
}
